# Copia este fichero a .env y ajusta los valores.
# Base de datos del pipeline (la que levanta docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://energia:energia@localhost:5433/energia
# Base de datos de pruebas: los tests de integración BORRAN y recrean sus esquemas.
TEST_DATABASE_URL=postgresql+psycopg2://energia:energia@localhost:5433/energia_test
# Primer día a cargar cuando no hay marca de agua (primera ejecución):
ENERGIA_FECHA_INICIO=2023-01-01
# Días que se vuelven a pedir en cada ejecución para recoger revisiones de la fuente:
ENERGIA_SOLAPE_DIAS=7
